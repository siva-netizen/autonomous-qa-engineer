# Local-only values. Never commit .env.
SHOPDEMO_REPO_URL=https://github.com/ettaverse/dummy-ecommerce
SHOPDEMO_DIR=./shopdemo
SHOPDEMO_BASE_URL=http://localhost:3000
QA_ARTIFACTS_DIR=./artifacts

# Gemini OpenAI-compatible configuration. Enter a local key; keep this placeholder empty.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_FALLBACK_MODEL=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_TIMEOUT_SECONDS=60

# Optional explicit MCP command configuration; no credentials belong here.
PLAYWRIGHT_MCP_COMMAND=npx
PLAYWRIGHT_MCP_PACKAGE=@playwright/mcp@0.0.31
